<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for use in a template to generate a WiX source file (.wxs) and then a Windows
  Installer package (.msi). The values for each variable are taken from the
  `Cargo.toml` manifest file, if defined, or reasonable defaults are used.

  The following variables are available for use: TargetTriple, TargetEnv,
  TargetFamily, TargetOs, TargetPointerWidth, TargetVendor, TargetArch,
  Profile, BinName, Description, ProductName, Authors, Copyright, License,
  LicenseSource, RTF, Repository, Homepage, Support, Icon, Banner, Dialog,
  Manufacturer, Product, Package, Version, CargoTargetBinDir, CargoTargetDir,
  CargoOutDir, BinaryName, BinaryPath, CargoBinDir, UpgradeCode, and
  PlatformProgramFilesFolder.

  More information about WiX can be found online at http://wixtoolset.org/.

  The rustc macro `cfg` can be used to conditionally select WiX XML elements
  and sources with the `cfg` preprocessor. This is enabled by default unless
  the `--no-cfg-preprocessing` command line argument is used.

-->

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

  <Product
    Id='*'
    Name='Stardew Valley Mod Manager'
    UpgradeCode='{{upgrade_code}}'
    Manufacturer='{{manufacturer}}'
    Language='1033'
    Codepage='1252'
    Version='{{version}}'>

    <Package Id='*'
      Keywords='Installer'
      Description='Stardew Valley Mod Manager - A desktop application for managing SMAPI mods'
      Manufacturer='{{manufacturer}}'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      SummaryCodepage='1252'
      InstallScope='perMachine' />

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

    <Media Id='1' Cabinet='Sample.cab' EmbedCab='yes' DiskPrompt="CD-ROM #1" />
    <Property Id='DiskPrompt' Value="Stardew Valley Mod Manager Installation [1]" />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='{{program_files_folder}}' Name='PFiles'>
        <Directory Id='APPLICATIONFOLDER' Name='{{product_name}}'>
          
          <!--
            Enabling the license sidecar file in the installer is a two step process:

            1. Uncomment the `Component` tag along with its contents.

            2. Change the value of the `LicenseAgreementDlg` tag's `LicenseKey`
               attribute from 'BannerBitmap' to 'LicenseText'.
          -->
          <!--<Component Id='License' Guid='*'>
            <File Id='LicenseFile'
              Name='License.rtf'
              DiskId='1'
              Source='wix\License.rtf'
              KeyPath='yes' />
          </Component>-->

          <Component Id='Path' Guid='{{path_component_guid}}' Win64='{{win64}}'>
            <Environment Id='PATH' Name='PATH' Value='[APPLICATIONFOLDER]' Permanent='no' Part='last' Action='set' System='yes' />
          </Component>
          
          <Component Id='binary0' Guid='*' Win64='{{win64}}'>
            <File
              Id='exe0'
              Name='{{bin_name}}.exe'
              DiskId='1'
              Source='{{binary_path}}'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="Stardew Valley Mod Manager">
          <Component Id="ProgramMenuDir" Guid="*">
            <RemoveFolder Id='ProgramMenuDir' On='uninstall'/>
            <RegistryValue Root='HKCU' Key='Software\[Manufacturer]\[ProductName]' Type='string' Value='' KeyPath='yes'/>
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Feature
      Id='Binaries'
      Title='Application'
      Description='Installs all binaries and the license.'
      Level='1'
      ConfigurableDirectory='APPLICATIONFOLDER'
      AllowAdvertise='no'
      Display='expand'
      Absent='disallow'>
      
      <!--
        Comment out or remove the following `ComponentRef` tag to remove
        the license sidecar file from the installer.
      -->
      <!--<ComponentRef Id='License' />-->

      <ComponentRef Id='binary0' />

      <Feature
        Id='Environment'
        Title='PATH Environment Variable'
        Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='Path' />
      </Feature>
    </Feature>

    <Feature Id="StartMenuComponents" Title="Start Menu" Description="Start menu components" Level="1">
        <ComponentRef Id="ProgramMenuDir"/>
        <Component Id="ApplicationShortcut" Guid="*">
            <Shortcut Id="ApplicationStartMenuShortcut" 
                Name="Stardew Valley Mod Manager" 
                Description="A desktop application for managing SMAPI mods"
                Target="[#exe0]"
                WorkingDirectory="APPLICATIONFOLDER"/>
            <RemoveFolder Id="ProgramMenuDir" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Microsoft\StardewValleyModManager" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
       </Component>
    </Feature>

    <Feature Id="DesktopComponents" Title="Desktop Shortcut" Description="Desktop shortcut" Level="1">
        <Component Id="DesktopShortcut" Guid="*">
            <Shortcut Id="ApplicationDesktopShortcut" 
                Name="Stardew Valley Mod Manager" 
                Description="A desktop application for managing SMAPI mods"
                Target="[#exe0]"
                WorkingDirectory="APPLICATIONFOLDER"/>
            <RemoveFolder Id="DesktopFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Microsoft\StardewValleyModManager" Name="desktop" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
    </Feature>

    <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize' />

    <!--
      Uncomment the following `Icon` and `Property` tags to change the product
      icon.

      The product icon is the graphic that appears in the Add/Remove
      Programs control panel for the application.
    -->
    <Icon Id='ProductICO' SourceFile='{{icon_path}}'/>
    <Property Id='ARPPRODUCTICON' Value='ProductICO' />

    <Property Id='ARPHELPLINK' Value='{{homepage_url}}' />
    
    <UI>
      <UIRef Id='WixUI_FeatureTree' />
      <!--
        Enabling the license sidecar file in the installer requires uncommenting
        the following `Publish` tag and changing the value of the `LicenseAgreementDlg`
        tag's `LicenseKey` attribute from 'BannerBitmap' to 'LicenseText'.
      -->
      <!--<Publish Dialog='LicenseAgreementDlg' Control='Print' Event='DoAction' Value='WixShellExecTarget'>LicenseText</Publish>-->
    </UI>

    <!--
      Enabling the license sidecar file in the installer requires uncommenting
      the following `WixVariable` tag and changing the value of the `LicenseAgreementDlg`
      tag's `LicenseKey` attribute from 'BannerBitmap' to 'LicenseText'.
    -->
    <!--<WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf' />-->

  </Product>

</Wix>